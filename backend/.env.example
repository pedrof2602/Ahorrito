PROJECT_NAME="Compras API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Base de datos. Vacío o ausente = SQLite en backend/compras.db, que es lo que
# querés para un solo usuario en tu máquina. Para mover la base a un servidor:
# DATABASE_URL="postgresql+asyncpg://usuario:password@host/compras"
# (requiere agregar asyncpg a requirements.txt)
DATABASE_URL=""

# --- Caché de precios --------------------------------------------------------
# Evita pegarle a la API de cada súper en cada búsqueda. En false se consulta
# siempre en vivo (y se pierde el respaldo de cadena caída).
PRICE_CACHE_ENABLED=true

# Cuánto vale un precio guardado antes de volver a preguntar, en segundos.
# 21600 = 6 h. Ojo con subirlo a 12 h: las promos bancarias son por día de la
# semana, así que una ventana larga puede servir a la mañana un precio de la
# tarde anterior con una promo que ya no corre.
PRICE_CACHE_TTL_S=21600

# Techo del precio vencido que se sirve cuando la cadena no responde, en
# segundos. 604800 = 7 días. Pasado esto se prefiere perder la cadena a mostrar
# un número que ya no significa nada.
PRICE_CACHE_STALE_MAX_S=604800

# --- Puerta de acceso ---------------------------------------------------------

# Clave compartida que hay que presentar para que el server conteste algo:
# páginas, API y /docs. Vacío = apagada, que es lo que querés en desarrollo.
#
# Es una capa distinta del login, no un reemplazo. El login dice *quién sos*;
# esto dice *si esta URL existe para vos*: sin la clave no hay ni formulario de
# login que tantear, ni /docs que enumerar, ni /search que usar como proxy
# contra los supermercados.
#
# Se presenta una vez como http://donde-corra/?k=<clave>, que deja una cookie y
# saca la clave de la URL. Para generarla:
#   openssl rand -base64 24 | tr -d /+=
#
# Hoy corre en la red de casa y la puerta está apagada (ver `.env.docker.example`
# en la raíz): no hay nadie de afuera a quien frenar, y el login protege todo
# igual. Esto existe para el día que la app quede expuesta a internet.
ACCESS_KEY=""

# Carpeta del frontend compilado, para servirlo desde el mismo server que la API.
# Vacío en desarrollo: ahí el frontend lo sirve Vite con hot reload. En el
# contenedor lo pone `.env.docker` apuntando al dist/ que dejó el build.
STATIC_DIR=""

# --- Autenticación -----------------------------------------------------------

# Si cualquiera puede crearse una cuenta. En false, `POST /auth/register` da 403
# y las cuentas las das de alta vos con scripts/set_password.py.
REGISTRATION_OPEN=true

# EN DESARROLLO PONELO EN FALSE. La cookie `Secure` no viaja por http://, así que
# con esto en true contra localhost el login devuelve 200 y la request siguiente
# da 401. Es el error más confuso de esta sección.
COOKIE_SECURE=true

# `lax`, `strict` o `none`. `lax` sirve —y bloquea CSRF— cuando el frontend y la
# API se sirven del mismo sitio. Si el frontend vive en otro dominio hace falta
# `none`, que exige COOKIE_SECURE=true y pierde esa protección.
COOKIE_SAMESITE=lax

# Solo si el frontend está en un subdominio distinto de la API.
# COOKIE_DOMAIN=".midominio.com"

# Vencimiento por inactividad y techo absoluto, en segundos. 30 y 180 días.
SESSION_TTL_S=2592000
SESSION_ABSOLUTE_TTL_S=15552000

# Intentos fallidos de login por IP antes de contestar 429, y en qué ventana.
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_S=300

# Largo mínimo de contraseña. Sin reglas de mayúsculas ni símbolos: empujan a
# `Password1!` y el NIST las desaconseja. El largo es lo que encarece el ataque.
PASSWORD_MIN_LENGTH=10
