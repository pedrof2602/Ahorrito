PROJECT_NAME="Compras API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Base de datos. Vacío o ausente = SQLite en backend/compras.db, que es lo que
# querés para un solo usuario en tu máquina. Para mover la base a un servidor:
# DATABASE_URL="postgresql+asyncpg://usuario:password@host/compras"
# (requiere agregar asyncpg a requirements.txt)
DATABASE_URL=""

# --- Caché de precios --------------------------------------------------------
# Evita pegarle a la API de cada súper en cada búsqueda. En false se consulta
# siempre en vivo (y se pierde el respaldo de cadena caída).
PRICE_CACHE_ENABLED=true

# Cuánto vale un precio guardado antes de volver a preguntar, en segundos.
# 21600 = 6 h. Ojo con subirlo a 12 h: las promos bancarias son por día de la
# semana, así que una ventana larga puede servir a la mañana un precio de la
# tarde anterior con una promo que ya no corre.
PRICE_CACHE_TTL_S=21600

# Techo del precio vencido que se sirve cuando la cadena no responde, en
# segundos. 604800 = 7 días. Pasado esto se prefiere perder la cadena a mostrar
# un número que ya no significa nada.
PRICE_CACHE_STALE_MAX_S=604800

# --- Puerta de acceso al deploy ----------------------------------------------

# Clave compartida que hay que presentar para que el server conteste algo:
# páginas, API y /docs. Vacío = apagada, que es lo que querés en desarrollo.
#
# Es una capa distinta del login, no un reemplazo. El login dice *quién sos*;
# esto dice *si esta URL existe para vos*, y es lo que hace que el deploy sea
# "por link directo": sin la clave no hay ni formulario de login que tantear, ni
# /docs que enumerar, ni /search que usar como proxy contra los supermercados.
#
# Se comparte como https://tu-app.fly.dev/?k=<clave>, que deja una cookie y
# saca la clave de la URL. En Fly NO va acá sino como secret:
#   fly secrets set ACCESS_KEY="$(openssl rand -base64 24 | tr -d /+=)"
ACCESS_KEY=""

# Carpeta del frontend compilado, para servirlo desde el mismo server que la API.
# Vacío en desarrollo: ahí el frontend lo sirve Vite con hot reload. En el deploy
# lo pone fly.toml apuntando al dist/ que dejó el build.
STATIC_DIR=""

# --- Autenticación -----------------------------------------------------------

# Si cualquiera puede crearse una cuenta. En false, `POST /auth/register` da 403
# y las cuentas las das de alta vos con scripts/set_password.py.
REGISTRATION_OPEN=true

# EN DESARROLLO PONELO EN FALSE. La cookie `Secure` no viaja por http://, así que
# con esto en true contra localhost el login devuelve 200 y la request siguiente
# da 401. Es el error más confuso de esta sección.
COOKIE_SECURE=true

# `lax`, `strict` o `none`. `lax` sirve —y bloquea CSRF— cuando el frontend y la
# API se sirven del mismo sitio. Si el frontend vive en otro dominio hace falta
# `none`, que exige COOKIE_SECURE=true y pierde esa protección.
COOKIE_SAMESITE=lax

# Solo si el frontend está en un subdominio distinto de la API.
# COOKIE_DOMAIN=".midominio.com"

# Vencimiento por inactividad y techo absoluto, en segundos. 30 y 180 días.
SESSION_TTL_S=2592000
SESSION_ABSOLUTE_TTL_S=15552000

# Intentos fallidos de login por IP antes de contestar 429, y en qué ventana.
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_S=300

# Largo mínimo de contraseña. Sin reglas de mayúsculas ni símbolos: empujan a
# `Password1!` y el NIST las desaconseja. El largo es lo que encarece el ataque.
PASSWORD_MIN_LENGTH=10

# --- Login with Amazon (vínculo con Alexa) -----------------------------------

# Client ID y Client Secret del Security Profile de Login with Amazon. Vacíos =
# el vínculo con Alexa está apagado. En Fly NO van acá sino como secrets:
#   fly secrets set LWA_CLIENT_ID="amzn1.application-oa2-client..." LWA_CLIENT_SECRET="..."
LWA_CLIENT_ID=""
LWA_CLIENT_SECRET=""

# A dónde vuelve Amazon con el código de autorización. Tiene que coincidir
# CARÁCTER POR CARÁCTER con el `Allowed Return URL` del Security Profile: Amazon
# lo compara literal y si no coincide contesta un `invalid_client` que no dice
# cuál de las dos puntas está mal.
LWA_REDIRECT_URI="https://ahorrito.fly.dev/auth/alexa/callback"

# Clave Fernet con la que se cifran los tokens de Amazon en la base. Se genera
# una sola vez, y en Fly va como secret:
#   fly secrets set TOKEN_ENCRYPTION_KEY="$(python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')"
# PERDERLA O ROTARLA VUELVE ILEGIBLES TODOS LOS VÍNCULOS y obliga a vincular de
# nuevo. Vacía = el vínculo con Alexa está apagado.
TOKEN_ENCRYPTION_KEY=""

# --- Skill de Alexa (esta app como proveedor OAuth) --------------------------
#
# OJO: esto va al REVÉS del bloque de arriba. En `LWA_*` esta app es el cliente
# de Amazon; acá es el proveedor y Alexa el cliente que viene a pedir tokens.
# El bloque de arriba quedó sin uso cuando Amazon apagó la List Management REST
# API el 1 de julio de 2024, que es el motivo de que exista todo esto.

# El ID del skill en la consola de desarrollador. Se compara contra el
# `applicationId` de cada request: sin él, cualquier otro skill con una firma
# válida de Amazon podría escribir en las listas de nuestros usuarios.
# Vacío = el endpoint del skill contesta 404.
ALEXA_SKILL_ID=""

# Credenciales que Alexa usa contra nuestro `/oauth/alexa/token`. Las inventamos
# nosotros y las pegamos en la consola, en Account Linking. El secret en Fly:
#   fly secrets set ALEXA_LINK_CLIENT_SECRET="$(python -c 'import secrets; print(secrets.token_urlsafe(32))')"
ALEXA_LINK_CLIENT_ID="ahorrito-alexa"
ALEXA_LINK_CLIENT_SECRET=""

# Las URLs a las que se puede devolver el código, tal cual las muestra la
# consola en Account Linking -> Alexa Redirect URLs. Son tres, una por región, y
# el <vendorId> es el tuyo. ES UNA WHITELIST Y SE COMPARA LITERAL: es lo único
# que impide que alguien arme un link que mande el código —y con él la cuenta—
# a su propio servidor.
ALEXA_LINK_REDIRECT_URIS='["https://layla.amazon.com/api/skill/link/TU_VENDOR_ID","https://pitangui.amazon.com/api/skill/link/TU_VENDOR_ID","https://alexa.amazon.co.jp/api/skill/link/TU_VENDOR_ID"]'
