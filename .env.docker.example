# Variables del contenedor de casa. Copiar a `.env.docker`, que está gitignoreado.
#
# Esto NO reemplaza a `backend/.env`: aquel es para correr el backend a mano con
# el venv, con hot reload y el frontend servido por Vite. Este es para el
# contenedor, donde la API y el SPA compilado salen del mismo server.
#
# Lo que no está acá se queda con el default de `backend/app/core/config.py`.

# La base, en el directorio ./data del host montado en /data. Cuatro barras y no
# tres: `sqlite+aiosqlite:///` es ruta relativa, `////data/...` es absoluta.
DATABASE_URL=sqlite+aiosqlite:////data/compras.db

# El dist/ que dejó el build del frontend, adentro de la imagen. Es lo que hace
# que la API y las páginas salgan del mismo origen y del mismo puerto.
STATIC_DIR=/app/static

# EN FALSE, Y NO ES OPCIONAL. La cookie `Secure` no viaja por http://, y en la
# LAN no hay https. Con esto en true el login devuelve 200 y el request
# siguiente 401: entrás bien y al recargar te echa, sin ningún error que lo
# explique. Es el síntoma más confuso de toda la configuración.
COOKIE_SECURE=false

# El frontend y la API comparten origen, así que `lax` alcanza —y es lo que
# bloquea CSRF—. No hace falta `none`.
COOKIE_SAMESITE=lax

# Vacío por lo mismo: un solo origen, no hay request cruzado que permitir.
CORS_ORIGINS=[]

# Tu cuenta ya existe (vino en la base que bajaste de Fly). En false, `POST
# /auth/register` da 403 y las altas se hacen con scripts/set_password.py.
REGISTRATION_OPEN=false

# La puerta de acceso, apagada. Existe para que un deploy público no se pueda
# enumerar desde afuera: sin la clave no hay formulario de login que tantear ni
# /docs que listar. En la red de tu casa no hay nadie de afuera a quien frenar,
# así que solo agregaría fricción en cada dispositivo. El login sigue
# protegiendo todo igual.
ACCESS_KEY=
